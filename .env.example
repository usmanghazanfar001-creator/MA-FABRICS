# Database — Neon: use the "Pooled connection" string for DATABASE_URL and
# the "Direct connection" string for DIRECT_URL (migrations need a direct,
# non-pgbouncer connection). Other Postgres hosts without pooling can point
# both at the same URL.
DATABASE_URL="postgresql://user:password@localhost:5432/ma_fabrics?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/ma_fabrics?schema=public"

# Auth
AUTH_SECRET="generate-a-long-random-string"
SESSION_COOKIE_NAME="ma_session"

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Business settings (never hard-code these in source)
NEXT_PUBLIC_SITE_NAME="MA Fabrics"
NEXT_PUBLIC_WHATSAPP_NUMBER="+92XXXXXXXXXX"

# Seed (dev only — do not use in production)
SEED_ADMIN_EMAIL="admin@mafabrics.test"
SEED_ADMIN_PASSWORD="ChangeMe123!"
